# DeepSeek（与 OpenAI SDK / Vercel AI SDK 兼容）
DEEPSEEK_API_KEY=
# 须包含 /v1，与 SDK 路径拼接一致；供本机 API 与 docker/pageindex 容器共用
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# PageIndex（密钥仅从本文件读取，代码中无默认值）
PAGEINDEX_API_KEY=
# 可选；默认 http://localhost:9090（与 docker/pageindex 暴露端口一致）
PAGEINDEX_BASE_URL=

# MinIO / S3（本机 API 与 docker/docker-compose.yml 中 MinIO 根账号、mc 建桶共用）
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Frontend CORS（默认前端端口避开 3000–4000，与 Vite 5173 对齐）
CORS_ALLOW_ORIGINS=http://localhost:5173

# 本地 API 监听端口（默认 4011，不在 3000–4000 内；与 `src/index.ts` 一致）
PORT=4011

# 观测：单行 JSON 日志 → Promtail → Loki → Grafana（示例栈见 docker/observability/docker-compose.yml）
# 可选；写入每条 JSON 的 service 字段，便于 Loki 标签/查询（默认 elysia-api）
LOG_SERVICE_NAME=elysia-api

# Chat 工具调用审计（默认关闭）。开启后每条工具事件为一行 JSON（schema=chat_tool_audit.v1），与全局 HTTP 访问日志同一 stdout，便于 Promtail 采集。
# 兼容旧值：minio/both 视为开启并仅写日志。内容已截断脱敏，仍可能含文档片段，请控制日志访问权限。
CHAT_TOOL_AUDIT=off
# 为 0 时 HTTP 访问日志使用旧式文本；默认 1 使用单行 JSON（schema=http_access.v1）
ACCESS_LOG_PLG_JSON=0

# ---------- docker/observability/docker-compose.yml（Grafana 管理员，从 .env 注入）----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# 为 true 时可匿名进 Explore；生产建议 false 并设置强密码
GRAFANA_ANONYMOUS_ENABLED=true
