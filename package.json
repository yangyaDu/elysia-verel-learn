{
  "name": "elysia-vercel-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:debug": "bun --inspect=127.0.0.1:9229/debug src/index.ts",
    "dev:vercel": "vercel dev --listen 8080",
    "dev:bun": "bun run --watch src/index.ts",
    "tsc-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:sync": "bun run scripts/sync-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/db-migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/deepseek": "^2.0.34",
    "@ai-sdk/openai": "^3.0.61",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@pageindex/sdk": "^0.8.0",
    "@sinclair/typebox": "^0.34.41",
    "ai": "^6.0.175",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.19",
    "minio": "^8.0.7",
    "mysql2": "^3.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vercel": "^41.7.8"
  }
}
