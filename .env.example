# DeepSeek（与 OpenAI SDK / Vercel AI SDK 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
# PageIndex
PAGEINDEX_API_KEY=

# MinIO / S3
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Frontend CORS
CORS_ALLOW_ORIGINS=http://localhost:3030

# MySQL 8（Docker：docker compose -f docker/docker-compose.yml --env-file .env up -d）
# 首次初始化时镜像会创建库 MYSQL_DATABASE，并授权 MYSQL_USER
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=pageIndex
# 本机已有 3306 占用时可改主机映射端口，并与 DATABASE_URL 端口一致
MYSQL_HOST_PORT=3306

# MySQL（Drizzle；未配置时文档/会话持久化相关逻辑跳过）
# 本机跑应用时指向映射端口；密码含特殊字符请做 URL 编码
# DATABASE_URL=mysql://MYSQL_USER:MYSQL_PASSWORD@127.0.0.1:3306/pageIndex
DATABASE_URL=

# PageIndex 树结果缓存秒数（仅当存在对应 documents 行时写入/读取快照）
TREE_SNAPSHOT_CACHE_SECS=300
